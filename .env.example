# Copy to .env and fill in. Never commit .env.

# ── AISStream ───────────────────────────────────────────────
# Free API key from https://aisstream.io
AISSTREAM_API_KEY=

# ── AWS / LocalStack endpoint ───────────────────────────────
# Fake credentials — LocalStack does not validate them.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# ── AIS subscription region ─────────────────────────────────
# South China Sea: Singapore / Malacca → Hong Kong → Taiwan → Shanghai
# Bounding box as [[[swLat, swLon], [neLat, neLon]]]
AIS_BBOX_SW_LAT=0.0
AIS_BBOX_SW_LON=99.0
AIS_BBOX_NE_LAT=32.0
AIS_BBOX_NE_LON=127.0
