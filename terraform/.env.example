# Copy to .env and fill in. Never commit .env.
# LocalStack container config — consumed by docker-compose.yml.
# Application secrets live in the project-root .env, not here.

# LocalStack Pro auth token. Leave blank for the free (Hobby) tier.
LOCALSTACK_AUTH_TOKEN=
# Verbose LocalStack logging: 1 or 0
DEBUG=0
# Persist state across restarts in localstack/data: 1 or 0 (Pro feature)
PERSISTENCE=1
